# 複製這個檔案為 .env，並填入你自己的金鑰
# .env 已經被 .gitignore 排除，不會被提交到 GitHub，可以放心填真正的金鑰

# Google Places API 金鑰(景點 Google 地圖批次匯入功能用)
GOOGLE_MAPS_API_KEY=

# Claude API 金鑰(AI 助理對話功能用，到 console.anthropic.com 申請)
ANTHROPIC_API_KEY=

# 中央氣象署開放資料平台授權碼(訪客頁面「目的地天氣」功能用，到 opendata.cwa.gov.tw 申請)
CWA_API_KEY=

# Google 登入用的 OAuth Client ID/Secret(到 console.cloud.google.com 建立 OAuth 用戶端申請)
# 重新導向 URI 要設定為：http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE 登入用的 Channel ID/Secret(到 developers.line.biz 建立 LINE Login channel 申請)
# Callback URL 要設定為：http://127.0.0.1:5000/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
