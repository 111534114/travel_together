# 複製這個檔案為 .env，並填入你自己的金鑰
# .env 已經被 .gitignore 排除，不會被提交到 GitHub，可以放心填真正的金鑰

# Google Places API 金鑰(景點 Google 地圖批次匯入功能用)
GOOGLE_MAPS_API_KEY=

# Claude API 金鑰(AI 助理對話功能用，到 console.anthropic.com 申請)
ANTHROPIC_API_KEY=

# 中央氣象署開放資料平台授權碼(訪客頁面「目的地天氣」功能用，到 opendata.cwa.gov.tw 申請)
CWA_API_KEY=

# Google 登入 OAuth 設定
# 重新導向 URI：http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE Login Channel（developers.line.biz 建立 LINE Login channel）
# Callback URL：http://127.0.0.1:5000/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# LINE 官方帳號 Messaging API（developers.line.biz → 和 LINE Login 同一個 Provider 底下的 Messaging API channel）
# Channel secret 在 Basic settings 分頁；Channel access token (long-lived) 在 Messaging API 分頁最下方按 Issue
# Webhook URL：https://你的公開網址/line/webhook
LINE_BOT_CHANNEL_SECRET=
LINE_BOT_ACCESS_TOKEN=
# 官方帳號 Basic ID（Messaging API 分頁上方的 Bot basic ID，含 @）
LINE_BOT_BASIC_ID=

# 行程出發前一天 LINE 提醒的發送時間（0 到 23，預設 9）
TRIP_REMINDER_HOUR=9
# 網站公開網址（例如 https://xxxx.ngrok-free.dev）
PUBLIC_BASE_URL=

# LIFF ID（LINE Login channel 的 LIFF 分頁建立，Endpoint URL 填 https://你的公開網址/liff）
LIFF_ID=

# 忘記密碼信件用的 SMTP 設定
# 用 Gmail 的話：SMTP_HOST=smtp.gmail.com，SMTP_PORT=587，SMTP_USERNAME 填你的 Gmail 帳號，
# SMTP_PASSWORD 不要用一般登入密碼，去 Google 帳戶「安全性」開啟兩步驟驗證後，
# 到 https://myaccount.google.com/apppasswords 產生一組「應用程式密碼」填進來
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# SerpApi「Google Flights」API（機票搜尋的真實即時報價，價格會依日期浮動，優先資料來源）
# 免費自助註冊，不用審核：https://serpapi.com/users/sign_up
# 登入後在 Dashboard 首頁就會看到 API Key，免費方案每月 250 次查詢
SERPAPI_API_KEY=

# Amadeus 機票比價 API（備用資料來源，SerpApi 查不到時才會用這個）
# 免費自助註冊：https://developers.amadeus.com/register
# 註冊後到 My Self-Service Workspace 建立一個 App，就會拿到下面這兩個值（Test environment 免費）
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
